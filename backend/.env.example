APP_NAME="Student Management Board API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=file
QUEUE_CONNECTION=sync

# -----------------------------------------------------------------------
# Database (Supabase-hosted Postgres — see backend_details.md §2)
# Project ref: yphafnnptmcwevdocirc, region ap-south-1.
# NEVER commit the real password. Reset it from Supabase:
#   Project Settings -> Database -> Reset database password.
# -----------------------------------------------------------------------
DB_CONNECTION=pgsql

# Runtime queries -> transaction-mode pooler (port 6543).
DATABASE_URL=postgresql://postgres.yphafnnptmcwevdocirc:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.yphafnnptmcwevdocirc
DB_PASSWORD=
DB_SSLMODE=require

# Migrations only (php artisan migrate) -> session-mode pooler (port 5432).
DIRECT_URL=postgresql://postgres.yphafnnptmcwevdocirc:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_MIGRATIONS_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_MIGRATIONS_PORT=5432

# -----------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
JWT_TTL=720

# First admin login (backend_details.md §9) — used only by
# `php artisan db:seed --class=AdminSeeder`. Rotate the password after
# first login; it is never re-read once the admins table has a row.
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=Administrator

# -----------------------------------------------------------------------
# CORS — the frontend is static HTML with no fixed origin (backend_details.md §7).
# Comma-separated list of allowed origins, or "*" for development.
# -----------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
